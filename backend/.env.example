# ==============================================================================
# ShadowBoard — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (or 'backend/.env'):
#    cp .env.example .env
# 2. Replace the placeholder values with your actual API keys.
# 3. NEVER commit your actual '.env' file to Git or public repositories!
# ==============================================================================

# LLM Provider API Keys (Optional / Required only if running live external LLMs)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ShadowBoard control-plane credentials. Generate unique values in a secret
# manager; never use these example placeholders in an environment.
SHADOWBOARD_ADMIN_KEY=replace_with_a_high_entropy_admin_key
TARGET_CONTROL_KEY=replace_with_a_distinct_high_entropy_target_control_key

# Target Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
