# ==============================================================================
# ShadowBoard — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Configure the required parameters for your deployment.
# 3. NEVER commit your actual '.env' file to Git or public repositories!
# ==============================================================================

# =============================================================================
# Application Environment (Required)
# =============================================================================
APP_ENV=production
APP_NAME=ShadowBoard
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=warning
LOG_FORMAT=json

# =============================================================================
# API Authentication (REQUIRED in production; fail-closed if unset)
# =============================================================================
# Central administrative API key for /api routes. Required in production.
# Clients authenticate with header: "Authorization: Bearer <SHADOWBOARD_ADMIN_KEY>"
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SHADOWBOARD_ADMIN_KEY=change_me_to_a_random_32_byte_secret_key
SHADOWBOARD_API_KEY=

# =============================================================================
# CORS Configuration (Required; Never set to '*' with credentials)
# =============================================================================
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:3000

# =============================================================================
# Target Models & LLM Providers (Optional / Required only for live LLM targets)
# =============================================================================
TARGET_MODEL=qwen-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# =============================================================================
# Cryptographic Evidence Signing (Optional in dev; Required for signed evidence)
# =============================================================================
# Absolute or relative path to Ed25519 PEM private key for signing evidence bundles
SIGNING_KEY_PATH=
# Key identifier registered in the key verification registry
KEY_ID=default-key-1

# =============================================================================
# Target Scanners & Substrates (Optional)
# =============================================================================
TARGET_APP_URL=http://127.0.0.1:8000/target-app
SCAN_TIMEOUT_SECONDS=300
